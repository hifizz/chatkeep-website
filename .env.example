# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/fullstack-starter"


# 应用的基础 URL
BETTER_AUTH_URL="http://localhost:3000"

# 一个用于加密和哈希的随机密钥。
# 你可以使用 "openssl rand -base64 32" 这个命令在终端里生成一个,
# 或者使用任何你喜欢的在线生成器。
# 例如: BETTER_AUTH_SECRET="your-super-secret-key-generated-here"
BETTER_AUTH_SECRET="your-super-secret-key-generated-here"

# 点击 https://resend.com/api-keys 注册然后生成一个 apikey
RESEND_API_KEY="your-resend-api-key"

# 允许跨域访问 /api/auth 与 /api/rpc 的来源（逗号分隔）
# 建议包含扩展 ID 与本地/开发环境来源
AUTH_ALLOWED_ORIGINS="chrome-extension://ajmlmkmckibkifaofppjellodbfmhkkb,http://localhost:3030,http://localhost:3000,http://localhost:3040,https://dev-chat-aside.zilin.im,https://chatkeep.dev,https://dev.chatkeep.dev"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Creem
CREEM_API_KEY="creem_test_key"
CREEM_WEBHOOK_SECRET="creem_webhook_secret"
CREEM_PRODUCT_ID_MONTHLY="creem_prod_monthly_placeholder"
CREEM_PRODUCT_ID_ANNUAL="creem_prod_annual_placeholder"

# Subscription Policy
SUBSCRIPTION_TRIAL_DAYS="7"
PAST_DUE_GRACE_DAYS="5"

# Internal extension release sync
RELEASE_SYNC_SECRET="your-release-sync-shared-secret"
RELEASE_SYNC_ALLOWED_REPO="your-org/your-extension-repo"

# ── Cloudflare R2（产物发布 Artifact Publish）──────────────────────────
# website 用 S3 兼容 API 写 R2;Worker(artifact-pages)用 binding 读同一个桶。
# 桶可复用于其他功能;本服务对象都在 `artifacts/` 前缀下。按环境切换：
#   dev  : R2_BUCKET=chatkeep-dev    ARTIFACT_PAGES_BASE_URL=https://pages-staging.chatkeep.dev
#   prod : R2_BUCKET=chatkeep-prod   ARTIFACT_PAGES_BASE_URL=https://pages.chatkeep.dev
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# 可留空,默认 https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=""
R2_BUCKET="chatkeep-dev"
ARTIFACT_PAGES_BASE_URL="https://pages-staging.chatkeep.dev"
